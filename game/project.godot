; Engine configuration file.
config_version=5

[application]

config/name="No Man's Drive"
config/description="An open-road survival game: drive, scavenge, hunt, camp and build."
config/version="1.9.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.07, 0.08, 1)
config/icon="res://icon.png"

[autoload]

Game="*res://scripts/game.gd"
Audio="*res://scripts/audio.gd"
Lib="*res://scripts/lib.gd"
Net="*res://scripts/net.gd"
Items="*res://scripts/items.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/atlas_size.mobile=4096
