static func item_name(id: String) -> String:
	return ITEMS[id]["name"] if ITEMS.has(id) else id.capitalize()

static func cost_text(cost: Dictionary) -> String:
	var parts: Array[String] = []
	for k in cost:
		parts.append("%d %s" % [cost[k], item_name(k)])
	return ", ".join(parts)
